<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/calendar_day_background"
    android:foreground="?attr/selectableItemBackground"
    android:minHeight="@dimen/calendar_day_min_height"
    android:orientation="vertical"
    android:padding="@dimen/calendar_day_padding">

    <TextView
        android:id="@+id/day_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/calendar_day_number_text_size"
        android:textStyle="bold"
        tools:text="23" />

    <LinearLayout
        android:id="@+id/day_chores"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>
