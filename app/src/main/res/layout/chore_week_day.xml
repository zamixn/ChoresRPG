    android:layout_marginTop="@dimen/day_circle_view_margin"
    android:layout_marginEnd="@dimen/day_circle_view_margin"
    android:layout_marginBottom="@dimen/day_circle_view_margin"
    android:textSize="@dimen/day_circle_view_text_size"
