<?xml version="1.0" encoding="utf-8"?>
<!-- Invite code input for the "Join with a code" popup. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dialog_content_padding"
    android:paddingTop="@dimen/chore_view_day_margin"
    android:paddingEnd="@dimen/dialog_content_padding">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/group_code_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/code_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textNoSuggestions|textVisiblePassword"
            android:maxLength="100" />
    </com.google.android.material.textfield.TextInputLayout>

</FrameLayout>
