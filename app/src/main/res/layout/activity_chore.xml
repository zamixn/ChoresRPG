<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ChoreActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimaryVariant"
        android:theme="@style/Theme.ChoresRPG.AppBarOverlay">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:popupTheme="@style/Theme.ChoresRPG.PopupOverlay">

            <!-- Title bar: chore icon and description, each with its edit button. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/chore_icon"
                    android:layout_width="@dimen/chore_view_toolbar_icon_size"
                    android:layout_height="@dimen/chore_view_toolbar_icon_size"
                    android:background="@drawable/toolbar_icon_background"
                    android:contentDescription="@string/chore_icon"
                    android:padding="@dimen/chore_view_toolbar_icon_padding"
                    tools:src="@drawable/floor_mop" />

                <ImageButton
                    android:id="@+id/edit_icon_button"
                    style="@style/ChoreEditButton"
                    android:contentDescription="@string/edit_icon" />

                <TextView
                    android:id="@+id/toolbar_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/chore_view_toolbar_title_margin"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.AppCompat.Widget.ActionBar.Title"
                    tools:text="Mop the floor" />

                <ImageButton
                    android:id="@+id/edit_description_button"
                    style="@style/ChoreEditButton"
                    android:contentDescription="@string/edit_description" />
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content_chore"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/chore_view_padding">

            <!-- Days -->
            <LinearLayout style="@style/ChorePropertyRow">

                <LinearLayout style="@style/ChorePropertyContent">

                    <TextView
                        style="@style/ChorePropertyLabel"
                        android:text="@string/chore_days_label" />

                    <LinearLayout
                        android:id="@+id/chore_days"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                    <TextView
                        android:id="@+id/chore_days_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/normal_text_size"
                        tools:text="Wednesday, Saturday" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/edit_days_button"
                    style="@style/ChoreEditButton"
                    android:contentDescription="@string/edit_days" />
            </LinearLayout>

            <!-- Last completed -->
            <LinearLayout style="@style/ChorePropertyRow">

                <LinearLayout style="@style/ChorePropertyContent">

                    <TextView
                        style="@style/ChorePropertyLabel"
                        android:text="@string/chore_last_completed_label" />

                    <TextView
                        android:id="@+id/chore_last_completed_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/normal_text_size"
                        tools:text="23 Nov 2026, 21:40" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/reset_last_completed_button"
                    style="@style/ChoreEditButton"
                    android:contentDescription="@string/reset_last_completed"
                    android:src="@drawable/ic_reset" />

                <ImageButton
                    android:id="@+id/edit_last_completed_button"
                    style="@style/ChoreEditButton"
                    android:contentDescription="@string/edit_last_completed" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/complete_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/chore_view_buttons_spacing"
                android:text="@string/complete_chore"
                app:icon="@drawable/ic_complete" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/delete_button"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/delete_chore"
                android:textColor="@color/delete_red"
                app:icon="@drawable/ic_delete"
                app:iconTint="@color/delete_red"
                app:strokeColor="@color/delete_red" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
