<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:descendantFocusability="blocksDescendants">

    <ImageView
        android:id="@+id/iconImage"
        android:layout_width="@dimen/chore_icon_size"
        android:layout_height="@dimen/chore_icon_size"
        android:contentDescription="@string/chore_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/chore_icon_cleaning_services" />

    <TextView
        android:id="@+id/descriptionTextView"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:contentDescription="@string/chore_description"
        android:gravity="center_vertical"
        android:text="TextView"
        android:textSize="@dimen/normal_text_size" />

    <!-- One spot at the end of the row, so the complete button and the green checkmark line up:
         the button (daily view, unfinished chore) or the checkmark (completed). -->
    <FrameLayout
        android:id="@+id/statusArea"
        android:layout_width="@dimen/chore_view_edit_button_size"
        android:layout_height="@dimen/chore_view_edit_button_size"
        android:layout_gravity="center_vertical"
        android:visibility="gone">

        <!-- Completes the chore without opening it. Only this spot reacts; the rest of the row opens the chore. -->
        <ImageView
            android:id="@+id/completeButton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/complete_chore"
            android:padding="@dimen/chore_completed_check_margin"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_complete_outline" />

        <!-- Shown when the chore is completed on the day the list is for. -->
        <ImageView
            android:id="@+id/completedImage"
            android:layout_width="@dimen/chore_completed_check_size"
            android:layout_height="@dimen/chore_completed_check_size"
            android:layout_gravity="center"
            android:contentDescription="@string/chore_completed_check"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_complete"
            app:tint="@color/completed_green" />
    </FrameLayout>
</androidx.appcompat.widget.LinearLayoutCompat>