rules_version = '2';

// ChoresRPG: each signed-in user can read and write only their own data (users/{userId}/...).
// Everything else is closed. Publish in the Firebase console: Firestore Database -> Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
