    <string name="ftue_settings_title">Daily reminders</string>
    <string name="ftue_settings_text">Get a morning and evening notification listing today\'s chores. Turn them on and pick times that suit you.</string>
    <string name="ftue_done_title">All done!</string>
    <string name="ftue_done_text">Add your first chore with the + button. You can change any of this later in Settings, in the ⋮ menu.</string>
