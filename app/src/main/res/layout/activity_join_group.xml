<?xml version="1.0" encoding="utf-8"?>
<!-- Opened by an invite link (JoinGroupActivity): confirm joining the group. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/join_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/ftue_padding"
    tools:context=".group.JoinGroupActivity">

    <ImageView
        style="@style/FtueStepImage"
        android:importantForAccessibility="no"
        android:src="@mipmap/ic_launcher" />

    <TextView
        android:id="@+id/join_title"
        style="@style/FtueStepTitle"
        tools:text="Join Žygimantas's group?" />

    <TextView
        android:id="@+id/join_text"
        style="@style/FtueStepText"
        tools:text="You'll share chores with everyone in it." />

    <ProgressBar
        android:id="@+id/join_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ftue_padding"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/join_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ftue_padding"
        tools:text="@string/group_join" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/cancel_button"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@android:string/cancel" />

</LinearLayout>
