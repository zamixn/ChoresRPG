<?xml version="1.0" encoding="utf-8"?>
<!-- Text of a weekday circle (drawable/day_circle): readable on the filled circle when selected, primary
     colored on the outlined ring otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="?attr/colorOnPrimary" android:state_selected="true" />
    <item android:color="?attr/colorPrimary" />
</selector>
