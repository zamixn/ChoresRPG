<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Chore view: one editable property (label + value on the left, edit button on the right). -->
    <style name="ChorePropertyRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/chore_view_section_spacing</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="ChorePropertyContent">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="ChorePropertyLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- A weekday circle (add-chore form, chore view); selected = filled. -->
    <style name="DayCircle">
        <item name="android:background">@drawable/day_circle</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/day_circle_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- The add-chore day picker: an equal share of the row, with a tappable circle in its middle. -->
    <style name="DayCircleSlot">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="DayCirclePicker" parent="DayCircle">
        <item name="android:layout_width">@dimen/day_circle_picker_size</item>
        <item name="android:layout_height">@dimen/day_circle_picker_size</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:textSize">@dimen/day_circle_picker_text_size</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <!-- The schedule editor's - / + buttons for "every n weeks / months". -->
    <style name="ScheduleStepperButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">@dimen/chore_view_edit_button_size</item>
        <item name="android:layout_height">@dimen/chore_view_edit_button_size</item>
        <item name="android:layout_marginStart">@dimen/form_label_spacing</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">@dimen/settings_title_text_size</item>
    </style>

    <!-- A labelled section of the add-chore form. -->
    <style name="FormSectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/form_section_spacing</item>
        <item name="android:layout_marginBottom">@dimen/form_label_spacing</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ChoreEditButton">
        <item name="android:layout_width">@dimen/chore_view_edit_button_size</item>
        <item name="android:layout_height">@dimen/chore_view_edit_button_size</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:src">@drawable/ic_edit</item>
    </style>

    <!-- Settings screen rows. -->
    <style name="SettingsSectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">@dimen/chore_view_padding</item>
        <item name="android:paddingEnd">@dimen/chore_view_padding</item>
        <item name="android:paddingTop">@dimen/settings_padding</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/settings_row_min_height</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">@dimen/chore_view_padding</item>
        <item name="android:paddingEnd">@dimen/chore_view_padding</item>
    </style>

    <style name="SettingsRowText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">@dimen/settings_padding</item>
        <item name="android:paddingBottom">@dimen/settings_padding</item>
    </style>

    <style name="SettingsRowTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/settings_title_text_size</item>
    </style>

    <!-- First-time setup (FTUE) steps. -->
    <style name="FtueStep">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/ftue_padding</item>
    </style>

    <style name="FtueStepImage">
        <item name="android:layout_width">@dimen/ftue_image_size</item>
        <item name="android:layout_height">@dimen/ftue_image_size</item>
        <item name="android:layout_marginBottom">@dimen/ftue_padding</item>
    </style>

    <style name="FtueStepTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">@dimen/ftue_title_text_size</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FtueStepText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/settings_padding</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">@dimen/settings_title_text_size</item>
    </style>

    <!-- A setting's current value that can be changed (e.g. a notification time). -->
    <style name="SettingsTimeValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/settings_value_text_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="SettingsRowSummary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:alpha">0.7</item>
    </style>
</resources>
