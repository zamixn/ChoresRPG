<?xml version="1.0" encoding="utf-8"?>
<!-- The add-chore form (AddChoreFragment): icon tile + description, the days it repeats on, its group
     (signed in only), and the Add chore button. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AddChoreFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/form_padding">

        <!-- Icon (tap to change) and description -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/icon_fragmentContainerView"
                android:name="com.zsoftware.choresrpg.choreicon.ChoreIconSelectorFragment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:layout="@layout/fragment_chore_icon_selector" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/description_layout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/form_padding"
                android:layout_weight="1"
                android:hint="@string/chore_description_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/chore_Description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textCapSentences" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Schedule -->
        <TextView
            style="@style/FormSectionLabel"
            android:text="@string/form_repeats_on" />

        <!-- Filled in by schedule.ScheduleEditor (schedule_editor.xml) -->
        <LinearLayout
            android:id="@+id/schedule_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Which group the chore goes into (starts as the main group). Signed in only. -->
        <LinearLayout
            android:id="@+id/group_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                style="@style/FormSectionLabel"
                android:text="@string/chore_group" />

            <LinearLayout
                android:id="@+id/group_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="@dimen/chore_view_edit_button_size"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/group_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="@dimen/settings_title_text_size"
                    tools:text="Žygimantas's group" />

                <ImageButton
                    android:id="@+id/change_group_button"
                    style="@style/ChoreEditButton"
                    android:contentDescription="@string/chore_group_change" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/add_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/form_section_spacing"
            android:paddingTop="@dimen/form_label_spacing"
            android:paddingBottom="@dimen/form_label_spacing"
            android:text="@string/form_add_chore" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
