<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context="com.zsoftware.choresrpg.MainActivity">
    <!-- View buttons, in this order: daily, weekly, monthly. -->
    <item
        android:id="@+id/action_daily_view"
        android:icon="@drawable/ic_daily_view"
        android:orderInCategory="1"
        android:title="@string/daily_view"
        app:showAsAction="always" />
    <item
        android:id="@+id/action_weekly_view"
        android:icon="@drawable/ic_weekly_view"
        android:orderInCategory="2"
        android:title="@string/weekly_view"
        app:showAsAction="always" />
    <item
        android:id="@+id/action_monthly_view"
        android:icon="@drawable/ic_monthly_view"
        android:orderInCategory="3"
        android:title="@string/monthly_view"
        app:showAsAction="always" />
    <item
        android:id="@+id/action_settings"
        android:orderInCategory="100"
        android:title="@string/action_settings"
        app:showAsAction="never" />
    <item
        android:id="@+id/action_delete_all_save_data"
        android:orderInCategory="99"
        android:title="@string/delete_all_save_data"
        app:showAsAction="never" />

    <!-- Debug builds only (shown by ScreenSetup.SetupDebugMenu): move the app's "today". -->
    <group
        android:id="@+id/debug_options"
        android:visible="false">
        <item
            android:id="@+id/action_simulate_next_day"
            android:orderInCategory="200"
            android:title="@string/simulate_next_day"
            app:showAsAction="never" />
        <item
            android:id="@+id/action_simulate_previous_day"
            android:orderInCategory="201"
            android:title="@string/simulate_previous_day"
            app:showAsAction="never" />
        <item
            android:id="@+id/action_simulate_real_day"
            android:orderInCategory="202"
            android:title="@string/simulate_real_day"
            app:showAsAction="never" />
        <item
            android:id="@+id/action_send_reminder_notification"
            android:orderInCategory="203"
            android:title="@string/send_reminder_notification"
            app:showAsAction="never" />
        <item
            android:id="@+id/action_show_ftue"
            android:orderInCategory="204"
            android:title="@string/show_ftue"
            app:showAsAction="never" />
    </group>
</menu>
