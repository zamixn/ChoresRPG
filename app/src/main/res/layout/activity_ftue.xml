<?xml version="1.0" encoding="utf-8"?>
<!-- First-time setup (FtueActivity): one step at a time, with Back / Next at the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ftue_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ftue.FtueActivity">

    <TextView
        android:id="@+id/step_indicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="@dimen/ftue_padding"
        android:textColor="?attr/colorPrimary"
        tools:text="Step 1 of 4" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 1. Welcome -->
            <LinearLayout
                android:id="@+id/step_welcome"
                style="@style/FtueStep">

                <ImageView
                    style="@style/FtueStepImage"
                    android:importantForAccessibility="no"
                    android:src="@mipmap/ic_launcher" />

                <TextView
                    style="@style/FtueStepTitle"
                    android:text="@string/ftue_welcome_title" />

                <TextView
                    style="@style/FtueStepText"
                    android:text="@string/ftue_welcome_text" />
            </LinearLayout>

            <!-- 2. Sign in, or keep chores only on this phone -->
            <LinearLayout
                android:id="@+id/step_account"
                style="@style/FtueStep"
                android:visibility="gone">

                <TextView
                    style="@style/FtueStepTitle"
                    android:text="@string/ftue_account_title" />

                <TextView
                    style="@style/FtueStepText"
                    android:text="@string/ftue_account_text" />

                <TextView
                    android:id="@+id/account_status"
                    style="@style/FtueStepText"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="Signed in as you@example.com"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sign_in_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ftue_padding"
                    android:text="@string/settings_sign_in" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/local_only_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ftue_local_only" />

                <!-- Shown instead of the two buttons above while signed in. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sign_out_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ftue_padding"
                    android:text="@string/settings_sign_out"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 2b. Groups (only while signed in) -->
            <LinearLayout
                android:id="@+id/step_groups"
                style="@style/FtueStep"
                android:visibility="gone">

                <TextView
                    style="@style/FtueStepTitle"
                    android:text="@string/ftue_groups_title" />

                <TextView
                    style="@style/FtueStepText"
                    android:text="@string/ftue_groups_text" />

                <TextView
                    android:id="@+id/groups_status"
                    style="@style/FtueStepText"
                    android:textStyle="bold"
                    tools:text="Your groups: Žygimantas's group (main)" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/create_group_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ftue_padding"
                    android:text="@string/group_create_new" />
            </LinearLayout>

            <!-- 3. Settings -->
            <LinearLayout
                android:id="@+id/step_settings"
                style="@style/FtueStep"
                android:visibility="gone">

                <TextView
                    style="@style/FtueStepTitle"
                    android:text="@string/ftue_settings_title" />

                <TextView
                    style="@style/FtueStepText"
                    android:text="@string/ftue_settings_text" />

                <include
                    android:id="@+id/notification_settings"
                    layout="@layout/notification_settings" />
            </LinearLayout>

            <!-- 4. All done -->
            <LinearLayout
                android:id="@+id/step_done"
                style="@style/FtueStep"
                android:visibility="gone">

                <ImageView
                    style="@style/FtueStepImage"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_complete"
                    app:tint="@color/completed_green" />

                <TextView
                    style="@style/FtueStepTitle"
                    android:text="@string/ftue_done_title" />

                <TextView
                    style="@style/FtueStepText"
                    android:text="@string/ftue_done_text" />
            </LinearLayout>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Back / Next -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/ftue_padding">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ftue_back" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/next_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ftue_next" />
    </LinearLayout>

</LinearLayout>
