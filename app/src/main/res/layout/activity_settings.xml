<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".settings.SettingsActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimaryVariant"
        android:theme="@style/Theme.ChoresRPG.AppBarOverlay">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:popupTheme="@style/Theme.ChoresRPG.PopupOverlay" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content_settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/settings_padding"
            android:paddingBottom="@dimen/settings_padding">

            <TextView
                style="@style/SettingsSectionHeader"
                android:text="@string/settings_account_header" />

            <!-- Account: "Not signed in" + Sign in button, or "Signed in as ..." + Sign out button. -->
            <LinearLayout
                android:id="@+id/account_row"
                style="@style/SettingsRow">

                <LinearLayout style="@style/SettingsRowText">

                    <TextView
                        android:id="@+id/account_title"
                        style="@style/SettingsRowTitle"
                        tools:text="@string/settings_not_signed_in" />

                    <TextView
                        android:id="@+id/account_summary"
                        style="@style/SettingsRowSummary"
                        tools:text="@string/settings_sign_in_summary" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/account_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/settings_padding"
                    tools:text="@string/settings_sign_in" />
            </LinearLayout>

            <!-- Only while signed in. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/delete_account_button"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/chore_view_padding"
                android:layout_marginEnd="@dimen/chore_view_padding"
                android:text="@string/delete_account"
                android:textColor="@color/delete_red"
                android:visibility="gone"
                app:icon="@drawable/ic_delete"
                app:iconTint="@color/delete_red"
                app:strokeColor="@color/delete_red"
                tools:visibility="visible" />

            <TextView
                style="@style/SettingsSectionHeader"
                android:text="@string/settings_notifications_header" />

            <include
                android:id="@+id/notification_settings"
                layout="@layout/notification_settings" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/test_notification_button"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/chore_view_padding"
                android:layout_marginTop="@dimen/chore_view_section_spacing"
                android:layout_marginEnd="@dimen/chore_view_padding"
                android:text="@string/settings_test_notification" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
