<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MonthActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/status_bar"
        android:theme="@style/Theme.ChoresRPG.AppBarOverlay">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/top_bar"
            app:popupTheme="@style/Theme.ChoresRPG.PopupOverlay" />

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:id="@+id/content_month"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <include
        android:id="@+id/period_navigator"
        layout="@layout/period_navigator" />

    <!-- The calendar is wider than the screen. This view scrolls sideways and moves the weekday
         header and the weeks together; only the weeks scroll vertically, so the header stays on top. -->
    <HorizontalScrollView
        android:id="@+id/calendar_horizontal_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/calendar_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/colorBackground"
                android:elevation="@dimen/calendar_header_elevation"
                android:orientation="horizontal"
                android:paddingStart="@dimen/calendar_padding"
                android:paddingTop="@dimen/calendar_padding"
                android:paddingEnd="@dimen/calendar_padding" />

            <androidx.core.widget.NestedScrollView
                android:id="@+id/calendar_scroll"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/calendar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/calendar_padding"
                    android:paddingEnd="@dimen/calendar_padding"
                    android:paddingBottom="@dimen/chore_list_bottom_padding" />

            </androidx.core.widget.NestedScrollView>

        </LinearLayout>

    </HorizontalScrollView>

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/add_chore_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:contentDescription="@string/add_chore"
        android:cropToPadding="false"
        app:fabSize="auto"
        app:srcCompat="@android:drawable/ic_input_add" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
